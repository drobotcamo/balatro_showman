{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permission": {
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git clean*": "ask",
      "git restore*": "ask",
      "git branch -D*": "ask",
      "git worktree remove*": "ask",
      "gh pr merge*": "ask",
      "gh release*": "ask",
      "rm -rf *": "ask",
      "Remove-Item -Recurse*": "ask"
    },
    "webfetch": "allow"
  }
}